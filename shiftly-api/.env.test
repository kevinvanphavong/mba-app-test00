# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Passphrase des clés JWT en test (clés générées avec cette valeur — dev/CI only,
# jamais la passphrase de prod qui, elle, est injectée par variable d'env).
JWT_PASSPHRASE=shiftly_jwt_passphrase

# Secret de signature du webhook Stripe — valeur de TEST connue (jamais la prod) :
# permet de forger une signature valide dans StripeWebhookTest.
STRIPE_WEBHOOK_SECRET=whsec_test_shiftly_phpunit
PUBLIC_SITE_BASE_URL=http://localhost

# Plafond IA bas en test pour exercer le coupe-circuit.
IA_PLAFOND_MENSUEL_CENTRE=5
