APP_ENV=prod
APP_SECRET=remplacer_par_openssl_rand_hex_32

# PostgreSQL partout (local = CI = cible prod).
# Format : postgresql://user:password@host:5432/dbname?serverVersion=16&charset=utf8
DATABASE_URL="postgresql://user:password@host:5432/dbname?serverVersion=16&charset=utf8"

# CORS — regex de l'URL frontend (origin_regex: true dans nelmio_cors.yaml)
# Prod ex : ^https://shiftly\.vercel\.app$
# Dev (.env local) : ^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$
CORS_ALLOW_ORIGIN=^https://votre-frontend\.vercel\.app$

# JWT — chemins vers les clés (gérées via entrypoint.sh au démarrage)
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=remplacer_par_la_passphrase_locale

# Clés JWT encodées en base64 (pour Railway)
# Générer : base64 -i config/jwt/private.pem | tr -d '\n'
JWT_SECRET_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=


# Sentry — monitoring des erreurs
SENTRY_DSN=https://your-dsn@sentry.io/your-project-id
SENTRY_AUTH_TOKEN=changeme
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=shiftly-api

# Cloudflare R2 — stockage objets compatible S3 (médias, photos completion)
# Bucket dev : shiftly-dev — bucket prod : shiftly-prod
# Endpoint : https://<account>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-r2-bucket
R2_ENDPOINT=https://your-r2-account-id.r2.cloudflarestorage.com

# Capture des leads — landing shiftly.fr → /api/leads → email Gmail
# 1. Activer la 2FA sur le compte Google
# 2. Générer un App Password : https://myaccount.google.com/apppasswords
# 3. Coller le mot de passe à 16 caractères dans GMAIL_APP_PASSWORD
# Procédure complète : docs/SETUP_EMAIL.md
GMAIL_USER=vanphavongk45@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
LEAD_NOTIFICATION_EMAIL=vanphavongk45@gmail.com
APP_BASE_URL=https://app.shiftly.fr
MAILER_DSN=gmail+smtp://${GMAIL_USER}:${GMAIL_APP_PASSWORD}@default

###> app/ai ###
# IA = Mistral AI (hebergement UE, RGPD). Vide = IA desactivee. Vraie cle dans .env.local.
MISTRAL_API_KEY=
MISTRAL_MODEL=pixtral-large-latest
###< app/ai ###

###> app/stripe ###
# Paiement de l'acompte (Stripe Checkout hébergé, mode test puis live).
# Récupère ces valeurs dans le dashboard Stripe ; ne JAMAIS les committer (.env.local).
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Base URL du site public (pages de retour succès/annulé).
PUBLIC_SITE_BASE_URL=https://app.shiftly.fr
###< app/stripe ###

###> app/ia-quota ###
# Plafond DUR d appels IA par centre et par mois (coupe-circuit cout Mistral).
IA_PLAFOND_MENSUEL_CENTRE=300
IA_PLAFOND_MENSUEL_PLATEFORME=500
###< app/ia-quota ###

###> app/pii ###
# Cle de chiffrement des PII des contacts (CRM) — genere une valeur forte dans .env.local.
PII_ENCRYPTION_KEY=change_me_base64_32_bytes
###< app/pii ###
