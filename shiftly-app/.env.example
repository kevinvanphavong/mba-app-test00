# URL de l'API Symfony.
# - En prod (Vercel) : ne PAS définir cette variable (ou la mettre à `/api`).
#   next.config.mjs force `/api` en prod et proxifie `/api/*` vers Railway via un
#   rewrite same-origin → cookie d'auth first-party, plus de boucle de login.
# - En local : pointer sur le backend Symfony lancé en dev.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Hosts « plateforme » du routing par domaine (src/middleware.ts), séparés par des
# virgules. Ces hosts gardent le routage normal (marketing / app gérant / admin) ;
# tout autre host est traité comme un domaine CLIENT et réécrit vers /site/*.
# `localhost` et `*.localhost` sont toujours considérés plateforme en dev (dans le code).
# Prod (exemple) : NEXT_PUBLIC_PLATFORM_HOSTS=shiftly.app,www.shiftly.app,app.shiftly.app,admin.shiftly.app
NEXT_PUBLIC_PLATFORM_HOSTS=

# Sentry — monitoring des erreurs frontend
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/your-project-id
